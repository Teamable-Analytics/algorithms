# Configuration for the local run (python -m local_run).
# Copy this file to env/local_run.env and adjust the values. env/local_run.env is not committed.
# Variables that are already set in the shell take precedence over this file,
# command line arguments (--input, --output, --seed) take precedence over both.

# Payload with students and algorithm options (relative to the repository root)
TEAMGEN_INPUT=local_run/sample_data/payload_priority_15_students.json

# Where to write the result JSON. Leave empty to print it to stdout.
TEAMGEN_OUTPUT=local_run/output/result.json

# Random seed for reproducible results. Leave empty for a different result on every run.
TEAMGEN_SEED=1

# Limits of the priority algorithm. Leave empty to use the defaults from PriorityAlgorithmConfig.
TEAMGEN_PRIORITY_MAX_TIME=
TEAMGEN_PRIORITY_MAX_ITERATE=
TEAMGEN_PRIORITY_MAX_KEEP=
TEAMGEN_PRIORITY_MAX_SPREAD=
